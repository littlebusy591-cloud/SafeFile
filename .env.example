# ---------------------------------------------------------------
# SafeFile configuration.
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to GitHub.
# ---------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string -- use ONE of the two lines below.
# 1) Local MongoDB installed on your computer:
MONGODB_URI=mongodb+srv://manishaext23_db_user:OuuRsph6jB2dRKrg@cluster0.oubev80.mongodb.net/
# 2) MongoDB Atlas (cloud). Replace <username>, <password>, <cluster>:
# MONGODB_URI=mongodb+srv://<username>:manishaext23_db_user<password>@<cluster>.mongodb.net/safefile?retryWrites=true&w=majority

# Secret used to sign login-session cookies. Must be long and random.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# File uploads
STORAGE_DRIVER=local
MAX_FILE_SIZE_MB=10

# Only needed later when deployed behind HTTPS / a reverse proxy (EC2):
# COOKIE_SECURE=true
# TRUST_PROXY=true
