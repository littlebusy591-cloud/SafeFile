    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
