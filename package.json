{
  "name": "safefile",
  "version": "1.0.0",
  "description": "SafeFile - Secure Document Vault (college Cloud Computing mini-project)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
